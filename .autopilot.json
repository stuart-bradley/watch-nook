{
  "queue": { "unit": "milestone", "order": "lowest-first", "skipLabels": ["needs-human"] },
  "branchPrefix": "auto/m",
  "riskPaths": [
    ".github/**", "**/signing*", "**/key.properties",
    "**/database/**", "**/*.g.dart", "**/*_schema.json",
    "**/main.dart", "**/*bootstrap*", "**/restore*",
    "**/auto_backup*", "android/app/src/main/res/xml/**",
    "**/remote_config*", ".autopilot.json"
  ],
  "caps": { "maxMilestonesPerNight": 2, "maxIterationsPerIssue": 8 },
  "breakers": { "noChangeLimit": 3, "sameErrorLimit": 5 }
}
